{
  "name": "arab-tili-boti",
  "version": "1.0.0",
  "description": "Professional Arab Tili O'quv Boti va Admin Paneli",
  "main": "dist/server.js",
  "scripts": {
    "dev:backend": "tsx watch src/server.ts",
    "dev:admin": "npm run dev --prefix admin",
    "dev": "concurrently -k -n \"BACKEND,ADMIN\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:admin\"",
    "build:backend": "tsc",
    "build:admin": "npm run build --prefix admin",
    "build": "npm run build:backend && npm run build:admin",
    "prestart": "npm run build",
    "start:backend": "tsx src/server.ts",
    "start:admin": "npm run start --prefix admin",
    "start": "concurrently -k -n \"BACKEND,ADMIN\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:admin\"",
    "postinstall": "node -e \"if (require('fs').existsSync('./admin/package.json')) { require('child_process').execSync('npm --prefix admin install', { stdio: 'inherit' }); }\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@types/multer": "^2.3.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "telegram-bot",
    "grammy",
    "arabic-learning",
    "admin-panel",
    "express"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
